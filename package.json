{
  "name": "xin-tweaks-free",
  "version": "1.0.1",
  "description": "XTweaks Free - Windows Tweaking Utility by Xin",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "build": "electron-builder",
    "build-native": "node-gyp rebuild",
    "clean": "node-gyp clean"
  },
  "keywords": [
    "tweaks",
    "optimization",
    "gaming",
    "performance",
    "windows"
  ],
  "author": "Xin",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^7.0.0",
    "three": "^0.184.0"
  },
  "gypfile": true,
  "build": {
    "appId": "com.xins.xtweaksfree",
    "productName": "XTweaks Free",
    "asar": false,
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "XTweaks Free",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
